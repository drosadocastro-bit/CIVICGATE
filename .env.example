# No live model is silently selected. mock is only for explicit offline demonstrations.
CIVICGATE_PROVIDER=unavailable
CIVICGATE_AGENT_PROVIDER=unavailable
CIVICGATE_JUDGE_PROVIDER=unavailable
CIVICGATE_AGENT_BASE_URL=http://127.0.0.1:1234/v1
CIVICGATE_JUDGE_BASE_URL=https://api.example.invalid
CIVICGATE_MODEL_BASE_URL=http://127.0.0.1:8080/v1
CIVICGATE_AGENT_MODEL=
CIVICGATE_JUDGE_MODEL=
# Credentials are supplied by the chosen SecretProvider or process environment at runtime.
CIVICGATE_MODEL_API_KEY=
CIVICGATE_AGENT_API_KEY=
CIVICGATE_JUDGE_API_KEY=
CIVICGATE_JUDGE_PROTOCOL=openai_compatible
CIVICGATE_AUDIT_PATH=audit/trace.jsonl
# Optional: confidence threshold in [0, 1], defaults to 0.85.
CIVICGATE_MIN_CONFIDENCE=0.85
