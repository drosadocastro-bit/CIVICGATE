{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civicgate:data01:synthetic-awards:v1",
  "title": "CIVICGATE DATA-01 entirely fictional award records",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "classification", "generated_by", "records"],
  "properties": {
    "dataset_id": {"const": "CIVICGATE-DATA01-v1"},
    "classification": {"const": "SYNTHETIC"},
    "generated_by": {"type": "string", "minLength": 1},
    "records": {
      "type": "array",
      "minItems": 40,
      "maxItems": 40,
      "items": {"$ref": "#/$defs/award"}
    }
  },
  "$defs": {
    "award": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "award_id", "recipient_name", "description", "awarding_agency",
        "awarding_subagency", "funding_agency", "funding_subagency", "award_amount",
        "award_type", "award_date", "fiscal_year", "place_of_performance_state",
        "review_status", "provenance"
      ],
      "properties": {
        "award_id": {"type": "string", "pattern": "^SYN-(FAA|DOT|NASA)-[A-Z]{2}-[0-9]{3}$"},
        "recipient_name": {"type": "string", "pattern": "^Fictional ", "maxLength": 200},
        "description": {"type": "string", "pattern": "^SYNTHETIC fictional award ", "maxLength": 200},
        "awarding_agency": {"enum": ["Department of Transportation", "National Aeronautics and Space Administration"]},
        "awarding_subagency": {"enum": ["Federal Aviation Administration", "Federal Highway Administration", "Federal Transit Administration", "National Aeronautics and Space Administration"]},
        "funding_agency": {"enum": ["Department of Transportation", "National Aeronautics and Space Administration"]},
        "funding_subagency": {"enum": ["Federal Aviation Administration", "Federal Highway Administration", "Federal Transit Administration", "National Aeronautics and Space Administration"]},
        "award_amount": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{2}$"},
        "award_type": {"enum": ["A", "B", "C", "D", "02", "03"]},
        "award_date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "fiscal_year": {"type": "integer", "minimum": 2025, "maximum": 2027},
        "place_of_performance_state": {"enum": ["PR", "FL", "CA", "TX", "NY", "DC", "GU", "VI", "MP"]},
        "review_status": {"const": "UNREVIEWED"},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "source", "actual_government_record"],
          "properties": {
            "classification": {"const": "SYNTHETIC"},
            "source": {"const": "CIVICGATE-DATA01-v1"},
            "actual_government_record": {"const": false}
          }
        }
      }
    }
  },
  "$comment": "generator.validate_dataset additionally enforces unique IDs, canonical dates, fiscal-year derivation, agency/funding hierarchies and ID agency/state consistency. No reviewed status mutation is authorized."
}
